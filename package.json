    "test:watch": "npm test -- --watch",
    "test:ci": "npm test -- --coverage",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "eslint": "^9.39.5",
    "eslint-config-love": "^155.0.0",
    "git-commit-msg-linter": "^5.0.9",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "npm test -- --findRelatedTests --passWithNoTests --bail"
    ]
  }
